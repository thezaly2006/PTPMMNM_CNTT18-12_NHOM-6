{
    "name": "detai12/pdf-workspace",
    "description": "Ung dung web sap xep, ghep, tach va xu ly tai lieu PDF tren trinh duyet",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "setasign/fpdi": "^2.6",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
