<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Chặn duyệt cây thư mục
    Options -Indexes

    # Chống truy cập file nhạy cảm
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Nếu không phải là file hoặc thư mục thực tế trong public, chuyển về index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
